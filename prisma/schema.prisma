generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "stock"]
}

enum Role {
  ADMIN
  MANAGER
  VIEWER
  STOCK

  @@schema("public")
}

enum EmployeeCategory {
  BRIGADE
  BACKOFFICE

  @@schema("public")
}

enum EmployeeType {
  NATIONAL
  EXPATRIE

  @@schema("public")
}

enum AttendanceCode {
  P // Présence — payé 100%
  O // Repos — payé 100%
  M // Maladie — payé 2/3
  A // Absence justifiée — payé 100%
  N // Absence non justifiée — non payé
  C // Congé payé — 100%
  F // Jour férié — payé 100%
  S // Congé sans solde — non payé

  @@schema("public")
}

enum PayrollStatus {
  BROUILLON
  VALIDE

  @@schema("public")
}

enum LeaveStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE

  @@schema("public")
}

// Machine à états d'un paiement de salaire (transitions contrôlées).
enum PaymentStatus {
  PAS_VALIDE // bulletin calculé, pas encore validé (ex-EN_ATTENTE / PREPARE / ANNULE)
  VALIDE // validé par un responsable, prêt à payer
  PAYE // paiement effectué

  @@schema("public")
}

enum ModePaiement {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  CHEQUE
  AUTRE

  @@schema("public")
}

// Compte utilisateur applicatif, lié au user Supabase Auth (id = auth.users.id)
model User {
  id         String    @id @default(uuid())
  email      String    @unique
  nom        String
  role       Role      @default(VIEWER)
  actif      Boolean   @default(true)
  employeeId String?   @unique // compte lié à une fiche employé (même personne)
  employe    Employee? @relation("CompteEmploye", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  leavesApproved     LeaveRequest[]     @relation("ApprovedBy")
  paiementsConfirmes PayrollLine[]      @relation("PayeParUser")
  transitionsPaie    TransitionPaie[]
  versionsBulletin   VersionBulletin[]
  actionsAudit       JournalAudit[]
  pushSubscriptions  PushSubscription[]

  @@schema("public")
}

// Abonnement Web Push d'un appareil (navigateur/PWA) d'un utilisateur. Un utilisateur peut avoir
// plusieurs appareils. Supprimé automatiquement si l'endpoint devient invalide (410/404).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@schema("public")
}

// Paramètres OPÉRATIONNELS (non légaux) — une seule ligne (id fixe "singleton").
// Les paramètres légaux (CNSS, IPR, INPP, ONEM, HS, congés...) sont dans ParametreLegal.
model Config {
  id            String   @id @default("singleton")
  tauxChangeCDF Decimal  @db.Decimal(10, 2)
  anneeCourante Int
  moisCourant   Int
  jourPaie      Int      @default(30) // jour du mois de la paie convenue (frise + alerte clôture)
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

enum StatutValidation {
  A_VALIDER
  VALIDE

  @@schema("public")
}

// Exercice fiscal : toutes les valeurs légales sont versionnées par exercice,
// modifiables uniquement par l'ADMIN (le directeur), jamais codées en dur.
model ExerciceFiscal {
  id    Int     @id @default(autoincrement())
  annee Int     @unique
  actif Boolean @default(false)

  parametres  ParametreLegal[]
  tranchesIpr TrancheIprCDF[]

  @@schema("public")
}

model ParametreLegal {
  id               Int              @id @default(autoincrement())
  exerciceId       Int
  exercice         ExerciceFiscal   @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  cle              String
  valeur           Decimal?         @db.Decimal(16, 6) // null = inconnu (ex. plafond CNSS non publié)
  unite            String? // "taux", "CDF", "USD", "heures", "jours", "personnes", "choix"
  libelle          String
  source           String?
  statutValidation StatutValidation @default(A_VALIDER)
  commentaire      String?
  updatedAt        DateTime         @updatedAt

  @@unique([exerciceId, cle])
  @@schema("public")
}

// Barème IPR officiel DGI — tranches ANNUELLES en CDF (diviser par 12 pour le mensuel).
model TrancheIprCDF {
  id               Int              @id @default(autoincrement())
  exerciceId       Int
  exercice         ExerciceFiscal   @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  ordre            Int
  plafondAnnuelCDF Decimal?         @db.Decimal(18, 2) // null = dernière tranche (au-delà)
  taux             Decimal          @db.Decimal(5, 4)
  statutValidation StatutValidation @default(A_VALIDER)

  @@unique([exerciceId, ordre])
  @@schema("public")
}

model JourFerie {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  designation String
  annee       Int

  @@unique([date])
  @@schema("public")
}

model Employee {
  id                       String           @id @default(uuid())
  matricule                String           @unique
  nom                      String
  sexe                     String
  etatCivil                String
  poste                    String
  secteur                  String
  categorie                EmployeeCategory
  salaireMensuel           Decimal          @db.Decimal(12, 2)
  transportJourCDF         Decimal          @default(0) @db.Decimal(12, 2)
  transportMoisCDF         Decimal          @default(0) @db.Decimal(12, 2)
  transportMoisUSD         Decimal          @default(0) @db.Decimal(12, 2)
  cnssMontant              Decimal          @default(0) @db.Decimal(12, 2)
  enfants                  Int              @default(0)
  type                     EmployeeType     @default(NATIONAL)
  dateNaissance            DateTime?        @db.Date
  telephone                String?
  email                    String?
  adresse                  String?
  photoUrl                 String?
  banque                   String?
  compteBancaire           String?
  mobileMoney              String?
  modePaiement             ModePaiement     @default(ESPECES) // moyen de paiement du salaire, pré-rempli au paiement
  idExterneIVMS            String? // identifiant du salarié dans IVMS-4200 (appariement pointage)
  dateEmbauche             DateTime         @db.Date
  contrat                  String
  heuresParJour            Decimal          @default(8) @db.Decimal(5, 2)
  heuresHebdomadaires      Decimal          @default(48) @db.Decimal(5, 2)
  fraisMedicauxMoisCourant Decimal          @default(0) @db.Decimal(12, 2)
  actif                    Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  attendances          Attendance[]
  overtimeEntries      OvertimeEntry[]
  payrollLines         PayrollLine[]
  leaveRequests        LeaveRequest[]
  remplaceDans         LeaveRequest[]         @relation("Remplacant")
  contrats             Contrat[]
  historiqueSalaire    HistoriqueSalaire[]
  dossierDisciplinaire DossierDisciplinaire[]
  evaluations          Evaluation[]
  documents            DocumentEmploye[]
  planningCreneaux     PlanningCreneau[]
  primes               Prime[]
  acomptes             AcompteSalaire[]
  fraisMed             FraisMedical[]
  compte               User?                  @relation("CompteEmploye")

  @@schema("public")
}

// Prime appliquée à un employé pour un mois donné (répercutée sur le bulletin de la période).
model Prime {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nom        String // ex. "Prime de performance"
  montantUSD Decimal  @db.Decimal(12, 2)
  mois       Int
  annee      Int
  createdAt  DateTime @default(now())
  creeParId  String?

  @@index([employeeId, annee, mois])
  @@schema("public")
}

enum StatutAcompte {
  EN_ATTENTE
  APPROUVE
  REFUSE

  @@schema("public")
}

// Types de congés/absences paramétrables. joursPayes / tauxPct = null → « À VALIDER »
// (par un comptable-juriste) et non appliqués en paie tant que non renseignés.
model TypeConge {
  id         String  @id @default(uuid())
  nom        String  @unique
  joursPayes Int? // nombre de jours payés (null = À VALIDER)
  tauxPct    Int? // taux de rémunération en % (null = À VALIDER)
  ordre      Int     @default(0)
  systeme    Boolean @default(false)
  actif      Boolean @default(true)

  @@schema("public")
}

// Demande d'acompte sur salaire : à approuver/refuser ; si approuvée, déduite du net du mois.
model AcompteSalaire {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  montantUSD   Decimal       @db.Decimal(12, 2)
  mois         Int
  annee        Int
  motif        String?
  statut       StatutAcompte @default(EN_ATTENTE)
  dateDemande  DateTime      @default(now())
  decideParId  String?
  dateDecision DateTime?

  @@index([employeeId, annee, mois])
  @@schema("public")
}

// Shift = créneau de planning CONFIGURABLE (modifiable/ajoutable depuis l'onglet Planning).
// Matin/Après-midi/Soir/Nuit ont des heures ; Repos/Congé/Férié sont « système » (heures nulles,
// non supprimables). « Nuit » sert au planning — AUCUNE majoration de nuit n'est appliquée en paie.
model Shift {
  id             String   @id @default(uuid())
  nom            String
  heureDebut     String? // "HH:MM" (null pour Repos/Congé/Férié)
  heureFin       String?
  couleur        String   @default("indigo") // clé de palette (mappée en classes Tailwind)
  dureeHeures    Decimal? @db.Decimal(5, 2) // durée en heures (si null, déduite de heureDebut/heureFin)
  tauxHoraireUSD Decimal? @db.Decimal(12, 4) // taux horaire de ce rôle (si null, taux par défaut de l employé)
  ordre          Int      @default(0)
  systeme        Boolean  @default(false) // Repos/Congé/Férié : non supprimables
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creneaux PlanningCreneau[]
  besoins  BesoinShift[]

  @@schema("public")
}

// Effectif requis par shift × poste × jour de la semaine — pilote la génération auto (couverture).
model BesoinShift {
  id           String   @id @default(uuid())
  shiftId      String
  shift        Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  poste        String // doit correspondre à Employee.poste
  jourSemaine  Int // 0=dimanche … 6=samedi
  nombreRequis Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shiftId, poste, jourSemaine])
  @@schema("public")
}

// Planning hebdomadaire prévisionnel (A3) : un shift par employé et par jour.
model PlanningCreneau {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date]) // planning : requêtes par plage de dates (génération auto, affichage mensuel)
  @@schema("public")
}

enum TypeContrat {
  CDD
  CDI
  STAGE
  JOURNALIER

  @@schema("public")
}

enum StatutContrat {
  ACTIF
  EXPIRE
  RESILIE

  @@schema("public")
}

// Contrat de travail : dates, période d'essai, échéance (pour alertes CDD).
model Contrat {
  id              String        @id @default(uuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            TypeContrat
  dateDebut       DateTime      @db.Date
  dateFin         DateTime?     @db.Date // null pour CDI
  finPeriodeEssai DateTime?     @db.Date
  heuresHebdo     Decimal       @default(48) @db.Decimal(5, 2)
  salaireMensuel  Decimal       @db.Decimal(12, 2)
  devise          String        @default("USD")
  poste           String
  statut          StatutContrat @default(ACTIF)
  documentUrl     String?
  createdAt       DateTime      @default(now())

  @@index([employeeId])
  @@schema("public")
}

// Historique salarial et promotions.
model HistoriqueSalaire {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  ancienSalaire  Decimal? @db.Decimal(12, 2)
  nouveauSalaire Decimal  @db.Decimal(12, 2)
  ancienPoste    String?
  nouveauPoste   String?
  motif          String // "Promotion", "Ajustement", "Embauche"...
  decideParId    String?

  @@index([employeeId])
  @@schema("public")
}

enum TypeDisciplinaire {
  AVERTISSEMENT
  SANCTION
  MISE_A_PIED
  MESURE

  @@schema("public")
}

// Dossier disciplinaire : sanctions, avertissements, mesures avec dates et pièces.
model DossierDisciplinaire {
  id          String            @id @default(uuid())
  employeeId  String
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        TypeDisciplinaire
  date        DateTime          @db.Date
  motif       String
  description String?
  documentUrl String?
  emisParId   String?
  createdAt   DateTime          @default(now())

  @@index([employeeId])
  @@schema("public")
}

// Évaluations de performance.
model Evaluation {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  note        Int? // sur 100, optionnel
  commentaire String?
  evaluateur  String?
  documentUrl String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@schema("public")
}

enum TypeDocument {
  CONTRAT
  CARTE_IDENTITE
  DIPLOME
  PHOTO
  CV
  CERTIFICAT_MEDICAL
  AVERTISSEMENT
  LETTRE
  AUTRE

  @@schema("public")
}

// Gestion documentaire par métadonnées (type, émission, expiration).
model DocumentEmploye {
  id             String       @id @default(uuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           TypeDocument
  nom            String
  fichierUrl     String
  dateEmission   DateTime?    @db.Date
  dateExpiration DateTime?    @db.Date // pour alertes (carte d'identité, certificat médical...)
  importeParId   String?
  createdAt      DateTime     @default(now())

  @@index([employeeId])
  @@schema("public")
}

// Fiche de poste : une par intitulé de poste (Employee.poste). Description libre + fichier
// importé (PDF ou Word), stocké dans Supabase Storage (URL conservée ici).
model FichePoste {
  id          String   @id @default(uuid())
  poste       String   @unique
  description String?  @db.Text
  fichierUrl  String?
  fichierNom  String?
  creeParId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

enum SourcePointage {
  MANUEL
  IVMS_RAPPORT
  IVMS_API

  @@schema("public")
}

// Trace chaque import de pointage (rapport IVMS-4200 ou API) : source, résultat, anomalies.
model ImportPointage {
  id           String         @id @default(uuid())
  source       SourcePointage
  nomFichier   String?
  mois         Int
  annee        Int
  nbLignes     Int            @default(0)
  nbAppliques  Int            @default(0)
  anomalies    Json? // liste des anomalies détectées (non appliquées silencieusement)
  importeParId String?
  date         DateTime       @default(now())

  @@index([annee, mois])
  @@schema("public")
}

model Attendance {
  id         String         @id @default(uuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime       @db.Date
  code       AttendanceCode
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@schema("public")
}

model OvertimeEntry {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  heuresTravaillees Decimal  @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@schema("public")
}

model PayrollRun {
  id                String        @id @default(uuid())
  mois              Int
  annee             Int
  statut            PayrollStatus @default(BROUILLON)
  dateCalcul        DateTime      @default(now())
  tauxChangeUtilise Decimal       @db.Decimal(10, 2)

  lignes PayrollLine[]

  @@unique([mois, annee])
  @@schema("public")
}

model PayrollLine {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  // Brigade — jours & HS (0 pour backoffice)
  joursPayes100   Int     @default(0)
  joursPayes2_3   Int     @default(0)
  joursNonPayes   Int     @default(0)
  nombreAbsences  Int     @default(0) // A + N + S sur la période
  remuneration100 Decimal @default(0) @db.Decimal(12, 2)
  remuneration2_3 Decimal @default(0) @db.Decimal(12, 2)
  hsValorisee     Decimal @default(0) @db.Decimal(12, 2)

  // Détail heures (snapshot au moment du calcul)
  heuresTravaillees    Decimal @default(0) @db.Decimal(6, 2)
  heuresContractuelles Decimal @default(0) @db.Decimal(6, 2)
  heuresSupp30         Decimal @default(0) @db.Decimal(6, 2)
  heuresSupp60         Decimal @default(0) @db.Decimal(6, 2)
  heuresSupp100        Decimal @default(0) @db.Decimal(6, 2)

  // Congés & frais médicaux
  joursCongePris     Int     @default(0)
  indemniteCongesUSD Decimal @default(0) @db.Decimal(12, 2)
  fraisMedicauxUSD   Decimal @default(0) @db.Decimal(12, 2)

  // Commun
  transportUSD      Decimal @default(0) @db.Decimal(12, 2)
  primesUSD         Decimal @default(0) @db.Decimal(12, 2)
  acompteUSD        Decimal @default(0) @db.Decimal(12, 2)
  salBrutUSD        Decimal @db.Decimal(12, 2)
  cnssSalarieUSD    Decimal @db.Decimal(12, 2)
  netImposableUSD   Decimal @db.Decimal(12, 2)
  iprCalculeUSD     Decimal @db.Decimal(12, 2)
  allocFamilialeUSD Decimal @db.Decimal(12, 2)
  salNetUSD         Decimal @db.Decimal(12, 2)
  salNetCDF         Decimal @db.Decimal(14, 2)
  cnssPatronalUSD   Decimal @db.Decimal(12, 2)
  inppUSD           Decimal @default(0) @db.Decimal(12, 2)
  onemUSD           Decimal @default(0) @db.Decimal(12, 2)
  coutEmployeurUSD  Decimal @db.Decimal(12, 2)
  coutEmployeurCDF  Decimal @db.Decimal(14, 2)

  // Machine à états du paiement
  statutPaiement PaymentStatus @default(PAS_VALIDE)
  datePaiement   DateTime?
  modePaiement   ModePaiement?
  payeParId      String?
  payePar        User?         @relation("PayeParUser", fields: [payeParId], references: [id])

  transitions      TransitionPaie[]
  versionsBulletin VersionBulletin[]

  @@unique([payrollRunId, employeeId])
  @@schema("public")
}

// Journal des transitions de la machine à états de paie (traçabilité complète).
model TransitionPaie {
  id            String        @id @default(uuid())
  payrollLineId String
  payrollLine   PayrollLine   @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  deStatut      PaymentStatus
  versStatut    PaymentStatus
  date          DateTime      @default(now())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  modePaiement  ModePaiement?
  preuveUrl     String? // pièce justificative (preuve de paiement) éventuelle
  commentaire   String?

  @@index([payrollLineId])
  @@schema("public")
}

// Versions immuables d'un bulletin : un bulletin émis n'est jamais écrasé, une nouvelle
// version est créée à chaque recalcul/réémission. Le snapshot fige tous les montants.
model VersionBulletin {
  id            String      @id @default(uuid())
  payrollLineId String
  payrollLine   PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  numeroVersion Int
  snapshot      Json // copie figée de la PayrollLine + employé au moment de l'émission
  genereLe      DateTime    @default(now())
  genreParId    String
  genrePar      User        @relation(fields: [genreParId], references: [id])

  @@unique([payrollLineId, numeroVersion])
  @@index([payrollLineId])
  @@schema("public")
}

// Journal d'audit : chaque modification sensible (salaire, contrat, congé, présence,
// statut de paie...) enregistre qui / quand / ancienne valeur / nouvelle valeur.
model JournalAudit {
  id             String   @id @default(uuid())
  entite         String // ex. "PayrollLine", "Employee", "LeaveRequest"
  entiteId       String
  champ          String // champ modifié, ou "statut", "creation", "suppression"
  ancienneValeur String?
  nouvelleValeur String?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime @default(now())

  @@index([entite, entiteId])
  @@index([date])
  @@schema("public")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String
  dateDebut     DateTime    @db.Date
  dateFin       DateTime    @db.Date
  nbJours       Decimal     @db.Decimal(5, 2)
  motif         String?
  remplacantId  String?
  remplacant    Employee?   @relation("Remplacant", fields: [remplacantId], references: [id])
  statut        LeaveStatus @default(EN_ATTENTE)
  approuveParId String?
  approuvePar   User?       @relation("ApprovedBy", fields: [approuveParId], references: [id])
  dateEnreg     DateTime    @default(now())

  @@index([employeeId])
  @@schema("public")
}

enum TypeTaxe {
  CNSS
  IPR
  INPP
  ONEM

  @@schema("public")
}

enum StatutDeclaration {
  A_DECLARER
  DECLARE
  PAYE

  @@schema("public")
}

// Suivi des déclarations mensuelles (CNSS avant le 15 du mois suivant ; délai IPR À VALIDER).
// Les montants sont figés au moment du marquage pour l'historique ; tant que A_DECLARER,
// la page recalcule depuis la paie du mois.
model DeclarationTaxe {
  id           String            @id @default(uuid())
  type         TypeTaxe
  mois         Int
  annee        Int
  montantUSD   Decimal           @db.Decimal(14, 2)
  montantCDF   Decimal           @db.Decimal(16, 2)
  echeance     DateTime          @db.Date
  statut       StatutDeclaration @default(A_DECLARER)
  marqueParId  String?
  dateMarquage DateTime?

  @@unique([type, mois, annee])
  @@schema("public")
}

/// Notifications in-app (cloche) destinées à la Direction : demandes de congé / d'acompte,
/// clôture de paie proche… `lu` global (petite structure, 1–2 comptes Direction).
model Notification {
  id        String   @id @default(uuid())
  domaine   String   @default("RH") // RH | STOCK — cloisonne la cloche par espace
  type      String // CONGE | ACOMPTE | CLOTURE | AUTRE
  refId     String? // id de la demande source (congé, acompte) — la notif est supprimée quand traitée
  message   String
  lien      String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([domaine, lu, createdAt])
  @@schema("public")
}

/// Fin de contrat (démission / licenciement / fin CDD) + solde de tout compte (loi RDC).
/// Les indemnités légales (préavis, licenciement) sont saisies par l'utilisateur — jamais
/// inventées par le logiciel — et à faire valider par un juriste.
model FinContrat {
  id                       String   @id @default(uuid())
  employeeId               String
  motif                    String // DEMISSION | LICENCIEMENT | FIN_CDD | AUTRE
  dateFin                  DateTime @db.Date
  salaireJournalierUSD     Decimal  @db.Decimal(12, 2)
  joursTravaillesMois      Int      @default(0)
  salaireProrataUSD        Decimal  @default(0) @db.Decimal(12, 2)
  joursCongesNonPris       Decimal  @default(0) @db.Decimal(6, 2)
  indemniteCongesUSD       Decimal  @default(0) @db.Decimal(12, 2)
  preavisJours             Int      @default(0)
  indemnitePreavisUSD      Decimal  @default(0) @db.Decimal(12, 2)
  indemniteLicenciementUSD Decimal  @default(0) @db.Decimal(12, 2)
  autresUSD                Decimal  @default(0) @db.Decimal(12, 2)
  totalUSD                 Decimal  @default(0) @db.Decimal(12, 2)
  commentaire              String?
  createdAt                DateTime @default(now())
  creeParId                String?

  @@index([employeeId])
  @@schema("public")
}

/// Modèle hebdomadaire de planning par employé : le shift (rôle) habituel pour chaque jour de la
/// semaine (0=dim … 6=sam). Sert à la génération automatique — gère les rôles variables (ex.
/// Aimée serveuse lun/mer/ven, assistante admin mar/jeu). Pas de shift pour un jour = repos.
model PlanningModele {
  id         String @id @default(uuid())
  employeeId String
  jour       Int
  semaine    Int    @default(0) // 0 = chaque semaine ; 1 = semaine A ; 2 = semaine B (bi-hebdo)
  shiftId    String

  @@unique([employeeId, jour, semaine])
  @@index([employeeId])
  @@schema("public")
}

/// Frais médical d'un employé pour un mois donné, avec certificat (justificatif) — s'ajoute au
/// remboursement de frais médicaux du bulletin de la période.
model FraisMedical {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  montantUSD    Decimal  @db.Decimal(12, 2)
  mois          Int
  annee         Int
  motif         String?
  certificatUrl String?
  createdAt     DateTime @default(now())
  creeParId     String?

  @@index([employeeId, annee, mois])
  @@schema("public")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MODULE STOCK & ACHATS — schéma Postgres séparé `stock` (cloisonné de la RH).
// Aucune FK cross-schéma : les références à un utilisateur sont des `creeParId String?`
// (même convention que Prime/AcompteSalaire côté RH). Argent en Decimal ; devise de saisie
// figée façon PayrollRun. Le niveau d'alerte est CALCULÉ en code depuis des seuils modifiables.
// ═══════════════════════════════════════════════════════════════════════════════

enum DomaineStock {
  NOURRITURE
  BOISSON
  AUTRE

  @@schema("stock")
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
  AJUSTEMENT

  @@schema("stock")
}

enum DeviseSaisie {
  USD
  CDF

  @@schema("stock")
}

enum StatutBonCommande {
  BROUILLON
  VALIDE
  ENVOYE
  RECU_PARTIEL
  RECU
  ANNULE

  @@schema("stock")
}

model Fournisseur {
  id             String   @id @default(uuid())
  nom            String
  produits       String? // description libre des produits fournis
  telephone      String?
  ville          String?
  pays           String?  @default("République démocratique du Congo")
  adresse        String?
  rccm           String?
  idNational     String?
  email          String?
  contactNom     String?
  delaiPaiement  String? // texte : données hétérogènes (« Paiement à la livraison », « 30 jours »)
  delaiLivraison String? // texte : « 1 », « 7 »…
  modePaiement   String? // « Espèces », « M-pesa »…
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  articles     ArticleStock[]
  bonsCommande BonDeCommande[]
  factures     FactureFournisseur[]

  @@schema("stock")
}

model CategorieStock {
  id      String       @id @default(uuid())
  nom     String
  domaine DomaineStock
  ordre   Int          @default(0)
  actif   Boolean      @default(true)

  articles ArticleStock[]

  @@unique([domaine, nom])
  @@schema("stock")
}

model ArticleStock {
  id              String          @id @default(uuid())
  code            String? // « Code article » du fichier (non fiable comme clé → optionnel)
  designation     String
  domaine         DomaineStock
  categorieId     String?
  categorie       CategorieStock? @relation(fields: [categorieId], references: [id])
  unite           String? // Kg, Pièce, L…
  uniteParCarton  Decimal?        @db.Decimal(10, 2)
  fournisseurId   String?
  fournisseur     Fournisseur?    @relation(fields: [fournisseurId], references: [id])
  prixUnitaireUSD Decimal?        @db.Decimal(12, 4) // prix de référence en USD
  prixCartonUSD   Decimal?        @db.Decimal(12, 4)
  prixOrigineCDF  Decimal?        @db.Decimal(16, 2) // provenance : préserve l'info d'origine
  tauxImportCDF   Decimal?        @db.Decimal(10, 2)
  codeBarres      String?
  poidsPaquet     Decimal?        @db.Decimal(10, 3)
  actif           Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  stock         Stock?
  mouvements    MouvementStock[]
  lignesBC      LigneBonDeCommande[]
  lignesFacture LigneFacture[]

  @@index([domaine, actif]) // catalogues (filtre par domaine) + comptage des articles actifs
  @@index([fournisseurId]) // fiche fournisseur : articles pris chez un fournisseur
  @@schema("stock")
}

model Stock {
  id                 String       @id @default(uuid())
  articleId          String       @unique
  article            ArticleStock @relation(fields: [articleId], references: [id], onDelete: Cascade)
  quantite           Decimal      @default(0) @db.Decimal(14, 3) // stock final courant
  stockMinimum       Decimal      @default(0) @db.Decimal(14, 3) // seuil « Approvisionnement nécessaire » (modifiable)
  seuilUrgent        Decimal      @default(0) @db.Decimal(14, 3) // seuil « Urgent » (modifiable)
  quantiteEndommagee Decimal      @default(0) @db.Decimal(14, 3) // « Article endommagé »
  updatedAt          DateTime     @updatedAt

  @@schema("stock")
}

model MouvementStock {
  id                String             @id @default(uuid())
  articleId         String
  article           ArticleStock       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type              TypeMouvementStock
  quantite          Decimal            @db.Decimal(14, 3) // toujours positif ; le sens vient de `type`
  date              DateTime           @default(now()) @db.Date
  origine           String? // « Réception BC 001/PEF/… », « Consommation cuisine », « Inventaire »
  devise            DeviseSaisie? // devise de saisie (FC ou USD selon le magasin)
  montantOrigine    Decimal?           @db.Decimal(16, 2) // valeur totale du mouvement, devise saisie
  tauxChangeUtilise Decimal?           @db.Decimal(10, 2) // taux figé au moment du mouvement
  montantUSD        Decimal?           @db.Decimal(14, 4) // équivalent USD figé
  receptionId       String?
  reception         Reception?         @relation(fields: [receptionId], references: [id])
  factureId         String?
  facture           FactureFournisseur? @relation(fields: [factureId], references: [id], onDelete: SetNull)
  categorieSortie   String? // pour une SORTIE : PERTE | LIVRAISON_RESTAURANT
  raisonSortie      String? // explication (obligatoire pour une perte)
  creeParId         String? // User.id (pas de FK cross-schéma)
  createdAt         DateTime           @default(now())

  @@index([articleId, date])
  @@index([factureId])
  @@index([categorieSortie, date])
  @@schema("stock")
}

model BonDeCommande {
  id                String            @id @default(uuid())
  numero            String            @unique // « 001/PEF/JUIN/26 »
  sequence          Int // remis à zéro chaque année
  annee             Int
  mois              Int
  date              DateTime          @default(now()) @db.Date
  fournisseurId     String?
  fournisseur       Fournisseur?      @relation(fields: [fournisseurId], references: [id])
  statut            StatutBonCommande @default(BROUILLON)
  delaiPaiement     String?
  modePaiement      String?
  totalUSD          Decimal           @default(0) @db.Decimal(14, 2)
  totalCDF          Decimal?          @db.Decimal(16, 2)
  tauxChangeUtilise Decimal?          @db.Decimal(10, 2)
  commentaire       String?
  documentUrl       String? // PDF d'origine joint (bons importés)
  creeParId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  lignes     LigneBonDeCommande[]
  receptions Reception[]
  factures   FactureFournisseur[]

  @@index([annee, mois])
  @@index([fournisseurId]) // fiche fournisseur + filtre des bons de commande par fournisseur
  @@schema("stock")
}

model LigneBonDeCommande {
  id              String        @id @default(uuid())
  bonDeCommandeId String
  bonDeCommande   BonDeCommande @relation(fields: [bonDeCommandeId], references: [id], onDelete: Cascade)
  articleId       String?
  article         ArticleStock? @relation(fields: [articleId], references: [id])
  designation     String // libellé figé (survit à la modif/suppression de l'article)
  unite           String?
  uniteParCarton  Decimal?      @db.Decimal(10, 2)
  nbCartons       Decimal?      @db.Decimal(10, 2)
  quantite        Decimal       @db.Decimal(14, 3)
  prixUnitaireUSD Decimal       @db.Decimal(12, 4)
  totalLigneUSD   Decimal       @db.Decimal(14, 2)

  @@schema("stock")
}

model Reception {
  id              String         @id @default(uuid())
  bonDeCommandeId String?
  bonDeCommande   BonDeCommande? @relation(fields: [bonDeCommandeId], references: [id])
  date            DateTime       @default(now()) @db.Date
  commentaire     String?
  creeParId       String?
  createdAt       DateTime       @default(now())

  mouvements MouvementStock[] // entrées de stock générées

  @@schema("stock")
}

model ParametresAchat {
  id                 String  @id @default("singleton")
  acheteurNom        String  @default("TOLYA SARL")
  acheteurAdresse    String?
  acheteurVille      String?
  acheteurPays       String?
  acheteurIdNational String?
  acheteurRccm       String?
  acheteurTelephone  String?
  acheteurContact    String?

  @@schema("stock")
}

enum StatutFacture {
  A_REGLER
  REGLEE
  ECHUE_NON_REGLEE

  @@schema("stock")
}

// Suivi des factures fournisseurs (comptes à payer). Source : « 2026 Suivi des factures
// fournisseurs.xlsx » (feuilles mensuelles). Montants en USD. Fournisseur optionnel (certaines
// factures viennent de fournisseurs hors catalogue) + libellé figé.
model FactureFournisseur {
  id              String         @id @default(uuid())
  fournisseurId   String?
  fournisseur     Fournisseur?   @relation(fields: [fournisseurId], references: [id])
  bonDeCommandeId String?
  bonDeCommande   BonDeCommande? @relation(fields: [bonDeCommandeId], references: [id])
  fournisseurNom  String // libellé figé (tel qu'écrit dans le suivi)
  numero          String?
  date            DateTime?      @db.Date
  dateEcheance    DateTime?      @db.Date
  datePaiement    DateTime?      @db.Date
  montantUSD      Decimal        @db.Decimal(14, 2)
  montantRegleUSD Decimal        @default(0) @db.Decimal(14, 2)
  resteAPayerUSD  Decimal        @default(0) @db.Decimal(14, 2)
  statut          StatutFacture  @default(A_REGLER)
  modePaiement    String?
  documentUrl     String? // PDF de la facture joint
  mois            Int
  annee           Int
  createdAt       DateTime       @default(now())

  lignes     LigneFacture[]
  mouvements MouvementStock[]
  paiements  Paiement[]

  @@index([annee, mois])
  @@index([fournisseurId])
  @@index([bonDeCommandeId])
  @@schema("stock")
}

// Paiement (total ou partiel) enregistré sur une facture fournisseur — historique daté.
model Paiement {
  id           String             @id @default(uuid())
  factureId    String
  facture      FactureFournisseur @relation(fields: [factureId], references: [id], onDelete: Cascade)
  date         DateTime           @db.Date
  montantUSD   Decimal            @db.Decimal(14, 2)
  modePaiement String?
  note         String?
  creeParId    String? // User.id (pas de FK cross-schéma)
  createdAt    DateTime           @default(now())

  @@index([factureId])
  @@schema("stock")
}

model LigneFacture {
  id              String             @id @default(uuid())
  factureId       String
  facture         FactureFournisseur @relation(fields: [factureId], references: [id], onDelete: Cascade)
  articleId       String?
  article         ArticleStock?      @relation(fields: [articleId], references: [id])
  designation     String // libellé figé (survit à la modif/suppression de l'article)
  unite           String?
  quantite        Decimal            @db.Decimal(14, 3)
  prixUnitaireUSD Decimal            @db.Decimal(12, 4)
  totalLigneUSD   Decimal            @db.Decimal(14, 2)

  @@index([factureId])
  @@schema("stock")
}

// ─── Achats de légumes frais (journal, hors catalogue permanent) ───
model AchatLegume {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  legume            String // libellé du légume (liste figée)
  unite             String?
  quantite          Decimal  @db.Decimal(14, 3)
  montantCDF        Decimal? @db.Decimal(16, 2)
  montantUSD        Decimal? @db.Decimal(14, 2)
  tauxChangeUtilise Decimal? @db.Decimal(10, 2)
  creeParId         String?
  createdAt         DateTime @default(now())

  @@index([date])
  @@schema("stock")
}

// ─── Journal d'import réversible (inventaire, factures) ───
model ImportBatch {
  id         String            @id @default(uuid())
  type       String // INVENTAIRE | FACTURES
  libelle    String // ex. « Inventaire Juillet 2026 » ou nom du fichier
  statut     String            @default("APPLIQUE") // APPLIQUE | ANNULE
  resume     Json? // compteurs affichés (mises à jour, créés, mouvements…)
  creeParId  String? // User.id (pas de FK cross-schéma)
  createdAt  DateTime          @default(now())
  annuleeAt  DateTime?
  operations ImportOperation[]

  @@index([type, createdAt])
  @@schema("stock")
}

// Une opération élémentaire d'un import, pour pouvoir l'annuler.
model ImportOperation {
  id       String      @id @default(uuid())
  batchId  String
  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entite   String // ArticleStock | Stock | MouvementStock | AchatLegume | FactureFournisseur | LigneFacture
  entiteId String
  action   String // CREATE | UPDATE
  avant    Json? // valeurs précédentes (pour restaurer un UPDATE) ; null pour un CREATE

  @@index([batchId])
  @@schema("stock")
}

// ─── Stock restaurant : grille journalière Cuisine / Bar ───
enum EspaceResto {
  CUISINE
  BAR

  @@schema("stock")
}

model ArticleResto {
  id                  String          @id @default(uuid())
  espace              EspaceResto
  categorie           String? // en-tête de section (« Viande -Volaille »…)
  designation         String
  unite               String?
  stockBaseJournalier Decimal?        @db.Decimal(14, 3) // niveau cible par jour
  ordre               Int             @default(0)
  actif               Boolean         @default(true)
  comptages           ComptageResto[]

  @@index([espace, ordre])
  @@schema("stock")
}

model ComptageResto {
  id             String       @id @default(uuid())
  articleRestoId String
  article        ArticleResto @relation(fields: [articleRestoId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  quantite       Decimal      @db.Decimal(14, 3)

  @@unique([articleRestoId, date])
  @@index([date])
  @@schema("stock")
}

// ─── Archives des fiches de comptage (inventaire physique) ───
model SessionComptage {
  id         String          @id @default(uuid())
  date       DateTime        @default(now()) @db.Date
  domaine    String? // NOURRITURE | BOISSON | AUTRE | null (tous)
  nbArticles Int             @default(0)
  nbEcarts   Int             @default(0) // lignes avec écart non nul
  nbHorsTol  Int             @default(0) // lignes hors tolérance (> seuil)
  creeParId  String?
  createdAt  DateTime        @default(now())
  lignes     LigneComptage[]

  @@index([date])
  @@schema("stock")
}

model LigneComptage {
  id          String          @id @default(uuid())
  sessionId   String
  session     SessionComptage @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  articleId   String?
  designation String
  theorique   Decimal         @db.Decimal(14, 3)
  physique    Decimal         @db.Decimal(14, 3)
  ecart       Decimal         @db.Decimal(14, 3)
  ecartPct    Decimal?        @db.Decimal(8, 2)
  explication String?

  @@index([sessionId])
  @@schema("stock")
}

// ─── Journal des rapports générés ───
model Rapport {
  id           String    @id @default(uuid())
  titre        String
  type         String // FACTURES | BONS_COMMANDE | PAIEMENTS | ACHATS | MOUVEMENTS | LEGUMES
  mode         String    @default("chiffre") // chiffre | detail
  format       String    @default("pdf") // pdf | excel
  periodeDebut DateTime? @db.Date
  periodeFin   DateTime? @db.Date
  creeParId    String?
  createdAt    DateTime  @default(now())

  @@index([type, createdAt])
  @@schema("stock")
}
